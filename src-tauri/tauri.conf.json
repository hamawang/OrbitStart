{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OrbitStart",
  "version": "0.9.2",
  "identifier": "local.orbitstart",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OrbitStart",
        "width": 1280,
        "height": 820,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": {
        "default-src": [
          "'self'"
        ],
        "base-uri": [
          "'self'"
        ],
        "form-action": [
          "'none'"
        ],
        "frame-ancestors": [
          "'none'"
        ],
        "object-src": [
          "'none'"
        ],
        "script-src": [
          "'self'"
        ],
        "style-src": [
          "'self'"
        ],
        "style-src-attr": [
          "'unsafe-inline'"
        ],
        "img-src": [
          "'self'",
          "data:",
          "blob:"
        ],
        "font-src": [
          "'self'",
          "data:"
        ],
        "media-src": [
          "'self'",
          "data:"
        ],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost"
        ],
        "worker-src": [
          "'self'",
          "blob:"
        ],
        "frame-src": [
          "'none'"
        ]
      },
      "devCsp": {
        "default-src": [
          "'self'"
        ],
        "base-uri": [
          "'self'"
        ],
        "form-action": [
          "'none'"
        ],
        "frame-ancestors": [
          "'none'"
        ],
        "object-src": [
          "'none'"
        ],
        "script-src": [
          "'self'"
        ],
        "style-src": [
          "'self'"
        ],
        "style-src-attr": [
          "'unsafe-inline'"
        ],
        "img-src": [
          "'self'",
          "data:",
          "blob:"
        ],
        "font-src": [
          "'self'",
          "data:"
        ],
        "media-src": [
          "'self'",
          "data:"
        ],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "ws://127.0.0.1:1420"
        ],
        "worker-src": [
          "'self'",
          "blob:"
        ],
        "frame-src": [
          "'none'"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "windows/nsis-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/xuxinxi14/OrbitStart/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE3Rjc5MjRCOTBGNjdGNjAKUldSZ2YvYVFTNUwzcDZsbysyL1NQSHA1Y2JwTUxocEkwYUhqajFNSnVKZk9YM3N3Z1liK1NXZWQK"
    }
  }
}
