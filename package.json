{
  "name": "orbitstart",
  "version": "0.8.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc --noEmit && vite build",
    "build:release-exe": "npm run build && cargo build --manifest-path src-tauri/Cargo.toml --release --bin orbitstart --features custom-protocol",
    "preview": "vite preview --host 127.0.0.1 --port 1421",
    "package:plugin": "powershell -ExecutionPolicy Bypass -File tools/package-plugin.ps1",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "version:set": "node tools/set-version.mjs",
    "version:check": "node tools/check-version-consistency.mjs",
    "release:verify": "node tools/check-version-consistency.mjs --release",
    "updater:manifest": "node tools/create-updater-manifest.mjs",
    "performance:compare": "node tools/compare-performance-measurements.mjs",
    "test:performance": "node tests/performance-compare-harness.cjs",
    "test:plugin-security": "node tools/check-plugin-security-contract.mjs",
    "test:plugin-host": "node tests/plugin-host-lifecycle-harness.cjs && node tests/workspace-launch-harness.cjs && node tests/plugin-worker-timeout-harness.cjs",
    "test:e2e": "node tools/run-e2e.mjs tests/basic.spec.ts tests/resource-path-repair.spec.ts tests/workspaces.spec.ts tests/motion.spec.ts tests/bubble-motion.spec.ts",
    "test:e2e:themes": "node tools/run-e2e.mjs tests/atelier-zero.spec.ts",
    "test:custom": "node tools/check-plugin-security-contract.mjs && node tests/custom-harness.cjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "lucide-react": "^0.468.0",
    "motion": "^12.43.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tauri-apps/cli": "^2.8.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
